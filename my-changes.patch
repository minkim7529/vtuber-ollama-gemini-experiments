 from .openai_compatible_llm import AsyncLLM
 
+THINK_OPEN_TAG = "<think>"
+THINK_CLOSE_TAG = "</think>"
+MAX_IMAGE_DIMENSION = 1024
+
+# Qwen models occasionally slip stray Chinese into an otherwise-Korean reply
+# (e.g. "팀장那儿 갔다가", "딸랑딸啷하면서", full-width "，"/"？" punctuation) -
+# a known small-model/quantization artifact, not something prompt wording
+# reliably prevents. The persona never legitimately speaks Chinese, so Han
+# characters (CJK Unified Ideographs) and CJK/full-width punctuation are
+# unconditionally safe to drop.
+HANZI_RE = re.compile(r"[一-鿿　-〿＀-￯]+")
+
+# The persona prompt asks for no emoji, but a 7B model doesn't reliably obey
+# that (same instruction-following ceiling as the honorific/register leaks) -
+# strip them deterministically instead of relying on the prompt alone.
+EMOJI_RE = re.compile(
+    "["
