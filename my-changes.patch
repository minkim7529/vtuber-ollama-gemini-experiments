+    @staticmethod
+    async def _strip_thinking(
+        source: AsyncIterator[str | List[Any]],
+    ) -> AsyncIterator[str | List[Any]]:
+        """Strips <think>...</think> blocks out of a streamed response."""
+        in_think = False
+        buffer = ""
+        max_tag_len = max(len(THINK_OPEN_TAG), len(THINK_CLOSE_TAG))
+
+        async for item in source:
+            if not isinstance(item, str):
+                yield item
+                continue
+
+            buffer += item
+            visible = ""
+
+            while True:
+                if not in_think:
+                    idx = buffer.find(THINK_OPEN_TAG)
+                    if idx == -1:
+                        keep_from = max(0, len(buffer) - (max_tag_len - 1))
+                        visible += buffer[:keep_from]
+                        buffer = buffer[keep_from:]
+                        break
+                    visible += buffer[:idx]
+                    buffer = buffer[idx + len(THINK_OPEN_TAG) :]
+                    in_think = True
+                else:
+                    idx = buffer.find(THINK_CLOSE_TAG)
+                    if idx == -1:
+                        keep_from = max(0, len(buffer) - (max_tag_len - 1))
+                        buffer = buffer[keep_from:]
+                        break
